int main() {
 int arr[]={1,2,3,4,5};
 int n=5;
 
 for(int i=0;i<n-2;i++){
     int temp=arr[i];
     arr[i]=arr[i+2];
     arr[i+2]=temp;
 }
 
 int result=0;
 
 for(int i=0;i<n;i++)
    result=result*10+arr[i];
 
 cout<<result;
}



int main() {
 int arr[]={2,3,4,5,6};
 int n=5;
 for(int i=0;i<n;i++){
     if(arr[i]%2==0){
     for(int j=i;j<n-1;j++)
        arr[j]=arr[j+1];
     n--;
     i--;
     }
 }
 
 int sum=0;
 
 for(int i=0;i<n;i++)
     sum+=arr[i];
 
 cout<<sum;
}



int main() {
 int arr[]={2,4,6,8};
 int total=0;
 for(int i=0;i<4;i++){
     total+=arr[i];
     
     if(total%3==0)
        continue;
     
     total+=1;
 }
 cout<<total;
}




int main() {
 int arr[] = {1,2,1,3,2};
 int n=5;
 
 for(int i=0;i<n;i++){
     int count=0;
     for(int j=0;j<n;j++)
        if(arr[i]==arr[j])
     
     count++;
     if(count>1)
        arr[i]=0;
 }
 
 int total=0;
 
 for(int i=0;i<n;i++)
    total+=arr[i];
 
 cout<<total;
}


